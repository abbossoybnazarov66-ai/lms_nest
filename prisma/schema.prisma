generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  fullname  String
  phone     String   @unique
  password  String
  photo     String?
  role      Role     @default(STUDENT)
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")

  mentorProfile MentorProfile?

  @@map("users")
}

enum Role {
  ADMIN
  MENTOR
  ASSISTANT
  STUDENT
}

// Mentorga xos qo'shimcha ma'lumotlar (User bilan 1:1 bog'langan)
model MentorProfile {
  id          Int     @id @default(autoincrement())
  experience  Int?
  job         String?
  description String?
  portfolio   String?
  github      String?
  telegram    String?
  linkedin    String?

  userId Int  @unique @map("user_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mentor_profiles")
}
