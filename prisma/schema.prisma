generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Staff {
  id        Int      @id @default(autoincrement())
  fullname  String
  phone     String   @unique
  password  String
  photo     String?
  role      String
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("staff")
}

model Teacher {
  id          Int      @id @default(autoincrement())
  fullname    String
  phone       String   @unique
  password    String
  photo       String?
  experience  Int?
  job         String?
  description String?
  portfolio   String?
  github      String?
  telegram    String?
  linkedin    String?
  status      String   @default("active")
  createdAt   DateTime @default(now()) @map("created_at")



  @@map("teachers")
}

model Student {          // ← yangi, eng oxirida
  id        Int      @id @default(autoincrement())
  fullname  String
  phone     String   @unique
  password  String
  photo     String?
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("students")
}